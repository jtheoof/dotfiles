# Claude Code via OpenRouter, used by claude-or (see .zshrc). Not loaded by
# environment.d. The key itself lives in environment.d/05-secrets.local.conf (gitignored).
# Comments must be on their own line: a trailing "# ..." becomes part of the value.
ANTHROPIC_BASE_URL="https://openrouter.ai/api"
ANTHROPIC_AUTH_TOKEN="$OPENROUTER_API_KEY"
# ANTHROPIC_API_KEY must not hold a real Anthropic key. The claude-or wrapper
# unsets it before sourcing this file.
CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=1
