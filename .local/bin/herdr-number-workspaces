#!/usr/bin/env bash
# Report each herdr workspace's position as the custom sidebar token $n, so the
# Space rows can show the number that alt+1..9 jumps to.
#
# Usage: herdr-number-workspaces          number once and exit
#        herdr-number-workspaces --watch  keep numbers fresh (one watcher per
#                                         herdr server, extra calls exit)
set -euo pipefail

number_once() {
  herdr workspace list |
    jq -r '.result.workspaces[] | "\(.workspace_id) \(.number)"' |
    while read -r id n; do
      herdr workspace report-metadata "$id" --source workspace-numbers \
        --token "n=$n" > /dev/null
    done
}

if [[ ${1:-} != --watch ]]; then
  number_once
  exit
fi

exec 9> "${XDG_RUNTIME_DIR:-/tmp}/herdr-number-workspaces.lock"
flock -n 9 || exit 0

last=
while sleep 1; do
  cur=$(herdr workspace list 2> /dev/null | jq -r '[.result.workspaces[] | "\(.workspace_id):\(.number)"] | join(",")') || break
  [[ -n $cur ]] || break
  if [[ $cur != "$last" ]]; then
    number_once && last=$cur
  fi
done
